{
	"name": "interactive-scrum-guide",
	"version": "0.0.1",
	"scripts": {
		"generate": "node src/generate.cjs",
		"predev": "npm run generate",
		"dev": "vite dev",
		"prebuild": "npm run generate",
		"build": "vite build",
		"prebuild:static": "npm run generate",
		"build:static": "TARGET=static vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"coverage": "vitest run --coverage",
		"prepare": "husky",
		"pre-commit": "npx lint-staged"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@lukulent/svelte-umami": "^0.0.4",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vitest/coverage-v8": "^4.1.7",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.56.0",
		"svelte-check": "^4.4.8",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	},
	"type": "module",
	"lint-staged": {
		"*.{js,ts,svelte,css,md,json}": "prettier --write",
		"*.{js,ts,svelte}": "eslint --fix"
	},
	"dependencies": {
		"stemmer": "^2.0.1",
		"svelte-exmarkdown": "^5.0.2"
	}
}
